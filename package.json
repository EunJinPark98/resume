{
  "name": "park-eunjin-resume",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "박은진 | 풀스택 개발자 이력서 홈페이지",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "check": "tsc --noEmit && node scripts/check-links.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
